{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://www.gstatic.com https://fonts.googleapis.com https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://www.gstatic.com https://region1.google-analytics.com; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://stats.g.doubleclick.net; font-src 'self' https://fonts.gstatic.com data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/cookies", "destination": "/cookies.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/learn", "destination": "/articles/what-is-lufs.html" },
    { "source": "/fr/about", "destination": "/fr/about.html" },
    { "source": "/fr/blog", "destination": "/fr/blog.html" },
    { "source": "/fr/pricing", "destination": "/fr/pricing.html" },
    { "source": "/fr/privacy", "destination": "/fr/privacy.html" },
    { "source": "/fr/terms", "destination": "/fr/terms.html" },
    { "source": "/fr/cookies", "destination": "/fr/cookies.html" },
    { "source": "/fr/contact", "destination": "/fr/contact.html" },
    { "source": "/articles/what-is-lufs", "destination": "/articles/what-is-lufs.html" },
    { "source": "/articles/spotify-loudness", "destination": "/articles/spotify-loudness.html" },
    { "source": "/articles/tiktok-loudness", "destination": "/articles/tiktok-loudness.html" },
    { "source": "/articles/true-peak", "destination": "/articles/true-peak.html" },
    { "source": "/articles/lra", "destination": "/articles/lra.html" },
    { "source": "/articles/why-minus-14-is-new-zero", "destination": "/articles/why-minus-14-is-new-zero.html" },
    { "source": "/articles/dbtp-true-peak-vs-sample", "destination": "/articles/dbtp-true-peak-vs-sample.html" },
    { "source": "/articles/ebu-r128-5-minutes", "destination": "/articles/ebu-r128-5-minutes.html" },
    { "source": "/fr/articles/what-is-lufs", "destination": "/fr/articles/what-is-lufs.html" },
    { "source": "/fr/articles/spotify-loudness", "destination": "/fr/articles/spotify-loudness.html" },
    { "source": "/fr/articles/tiktok-loudness", "destination": "/fr/articles/tiktok-loudness.html" },
    { "source": "/fr/articles/true-peak", "destination": "/fr/articles/true-peak.html" },
    { "source": "/fr/articles/lra", "destination": "/fr/articles/lra.html" },
    { "source": "/fr/articles/why-minus-14-is-new-zero", "destination": "/fr/articles/why-minus-14-is-new-zero.html" },
    { "source": "/fr/articles/dbtp-true-peak-vs-sample", "destination": "/fr/articles/dbtp-true-peak-vs-sample.html" },
    { "source": "/fr/articles/ebu-r128-5-minutes", "destination": "/fr/articles/ebu-r128-5-minutes.html" }
  ],
  "trailingSlash": false,
  "cleanUrls": false
}
